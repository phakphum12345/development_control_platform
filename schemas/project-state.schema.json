{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development Control Project State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "repository",
    "branch",
    "commit_sha",
    "observed_at",
    "gates"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "commit_sha",
          "observed_at"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "pending",
              "not_run",
              "unknown"
            ]
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_url": {
            "type": "string",
            "format": "uri"
          },
          "run_url": {
            "type": "string",
            "format": "uri"
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "evidence_url"
              ]
            }
          }
        ]
      }
    }
  }
}
