{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcp.local/schemas/terminal-command-pack.schema.json",
  "title": "DCP Terminal Studio inert command pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "templates"],
  "properties": {
    "schema_version": {"const": 1},
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "description", "category", "executable_id", "argv",
          "platforms", "timeout_seconds", "max_output_bytes", "network",
          "mutation_class"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^custom-[a-z0-9][a-z0-9-]{1,62}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "category": {"enum": ["Git", "Toolchain", "Build", "Test", "DCP", "Security", "Other"]},
          "executable_id": {"enum": ["git", "python", "node"]},
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"enum": ["windows", "linux", "macos"]}
          },
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
          "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
          "network": {"const": "denied"},
          "mutation_class": {
            "enum": [
              "read-only", "workspace-write", "dependency-install",
              "network", "destructive", "privileged"
            ]
          }
        }
      }
    }
  }
}
